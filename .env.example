# Copy to .env (git-ignored) and fill in. Dummy values only in this file.
# On Railway these are service Variables; there is no data folder, only the SQLite file at DB_PATH.

# Path of the SQLite file. Locally ./var/value_scanner.db; on Railway the mounted volume.
DB_PATH=./var/value_scanner.db

# Alert recipient and SEC contact address (User-Agent). Never logged or committed.
MY_EMAIL=you@example.com

# Dashboard login (E1) and session signing key (generate: python -c "import secrets;print(secrets.token_urlsafe(32))")
DASHBOARD_PASSWORD=change-me
SESSION_SECRET=change-me-too

# Gemini API key for company profiles (E7)
GOOGLE_API_KEY=your-gemini-key

# SMTP_* for alert emails are defined in B4.
